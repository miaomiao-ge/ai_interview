# Runtime
APP_ENV=production
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DB_AUTO_MIGRATE_ON_STARTUP=0

# MySQL app connection used by FastAPI, worker, migrations, imports, and sync jobs.
MYSQL_URL=mysql+pymysql://ai_interview:change-me@127.0.0.1:3306/interview_db?charset=utf8mb4

# MySQL bootstrap credentials used only by tools/bootstrap_database.py.
MYSQL_ADMIN_URL=mysql+pymysql://root:root-password@127.0.0.1:3306/mysql?charset=utf8mb4
MYSQL_DATABASE=interview_db
MYSQL_APP_USER=ai_interview
MYSQL_APP_PASSWORD=change-me
MYSQL_APP_HOST=%

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=1

# Admin account seeded by migrations.
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_PASSWORD=change-me-strong-password

# Aliyun ASR / TTS
ALI_AK_ID=
ALI_AK_SECRET=
ALI_APPKEY=
ALI_APPKEY_EN=

# LLM
DASHSCOPE_API_KEY=
LLM_BASE_URL=

# OSS
ALI_OSS_ENDPOINT=
ALI_OSS_BUCKET_NAME=
FACE_OSS_ENDPOINT=
FACE_OSS_BUCKET_NAME=

# Email
SMTP_SERVER=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Xidian student API
XIDIAN_STUDENT_API_BASE_URL=https://xdgjxs.xidian.edu.cn/smjFrame/foreignStudentInfo
XIDIAN_STUDENT_APP_KEY=
XIDIAN_STUDENT_APP_SECRET=
